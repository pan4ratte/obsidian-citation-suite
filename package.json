{
	"name": "zoterik",
	"version": "1.0.0",
	"description": "Cite your Zotero library from a note: a hotkey opens Zotero's citation window, and the pick is inserted as a pandoc citation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"author": "pan4ratte",
	"license": "AGPL-3.0",
	"type": "commonjs",
	"devDependencies": {
		"@types/node": "^24.13.3",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^16.5.0",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"obsidian": "$obsidian"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pan4ratte/obsidian-zoterik.git"
	},
	"bugs": {
		"url": "https://github.com/pan4ratte/obsidian-zoterik/issues"
	},
	"homepage": "https://github.com/pan4ratte/obsidian-zoterik#readme"
}
